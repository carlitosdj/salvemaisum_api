DB_HOST=db
DB_PORT=3306
DB_NAME=salvemaisum_dev
DB_USER=root
DB_PASSWORD=
JWT_SECRET=
APP_URL=http://localhost:3601
ADM_URL=http://localhost:3602
API_URL=http://localhost:3600
UPLOADS_DIR=uploads
# Comprovantes de doação: fora da pasta pública
PRIVADO_DIR=privado
FILES_ORIGIN=https://salvemaisum.com.br/files
# Credencial OAuth do Google (tipo Aplicativo da Web). Vazio = botão do Google desligado
GOOGLE_CLIENT_ID=
# App do Facebook. Vazio = botão desligado
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Notificações (Web Push): sem as chaves, ficam desligadas
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@salvemaisum.com.br
# Sem SMTP_HOST os e-mails só aparecem no log
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Salve Mais Um <aplicativo@salvemaisum.com.br>
