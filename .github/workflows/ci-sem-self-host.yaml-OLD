name: Docker CI/CD - API

on:
  push:
    branches: [main]

jobs:
  deploy:
    runs-on: ubuntu-latest

    steps:
      # 1️⃣ Checkout
      - name: Checkout código
        uses: actions/checkout@v4

      # 2️⃣ Deploy via rsync (igual hoje)
      - name: Deploy código via rsync
        env:
          SSH_PRIVATE_KEY: ${{ secrets.SSH_PRIVATE_KEY }}
          REMOTE_HOST: ${{ secrets.REMOTE_HOST }}
          REMOTE_USER: ${{ secrets.REMOTE_USER }}
          REMOTE_PORT: ${{ secrets.REMOTE_PORT }}
        run: |
          mkdir -p ~/.ssh
          echo "$SSH_PRIVATE_KEY" > ~/.ssh/deploy_key
          chmod 600 ~/.ssh/deploy_key

          # rsync TODO o código (exceto node_modules e dist)
          rsync -avz --delete \
            --exclude 'node_modules/' \
            --exclude '.git/' \
            --exclude 'dist/' \
            --exclude 'coverage/' \
            --exclude '*.log' \
            -e "ssh -i ~/.ssh/deploy_key -p $REMOTE_PORT -o StrictHostKeyChecking=no -o HostKeyAlgorithms=+ssh-rsa -o PubkeyAcceptedAlgorithms=+ssh-rsa" \
            ./ $REMOTE_USER@$REMOTE_HOST:/www/wwwroot/nodeapps/api/

      # 3️⃣ Build Docker e restart no servidor
      - name: Build Docker e restart
        uses: appleboy/ssh-action@master
        with:
          host: ${{ secrets.REMOTE_HOST }}
          username: ${{ secrets.REMOTE_USER }}
          key: ${{ secrets.SSH_PRIVATE_KEY }}
          port: ${{ secrets.REMOTE_PORT }}
          script: |
            cd /www/wwwroot/nodeapps/bin
            
            echo "🔨 Buildando imagem Docker da API..."
            docker compose -f docker-compose.prod.yml build api
            
            echo "🚀 Reiniciando container da API..."
            docker compose -f docker-compose.prod.yml up -d api
            
            echo "🧹 Limpando imagens antigas..."
            docker image prune -f
            
            echo "✅ Deploy do API concluído!"
            echo "📊 Status:"
            docker compose -f docker-compose.prod.yml ps api
